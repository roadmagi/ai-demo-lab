# Required. The only paid service in the whole lab.
ANTHROPIC_API_KEY=sk-ant-...

# Optional locally, required in production.
# Serverless functions share no memory, so the rate limiter, response cache,
# gap report, and uploads all need somewhere shared to live. Free tier at
# https://console.upstash.com — create a Redis database and copy the REST
# credentials. Without these the app falls back to process memory, which is
# fine for `npm run dev` and useless on a deployment.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults shown.
# Live questions per visitor per window (cache hits are always free).
CHAT_RATE_LIMIT=12
CHAT_RATE_WINDOW_SECONDS=3600
# Hard ceiling on tokens the whole lab may spend per UTC day. Set this to 0 to
# see the budget-exhausted path.
DEMO_DAILY_TOKEN_BUDGET=300000
# How long an answer stays in the response cache.
CACHE_TTL_SECONDS=604800
